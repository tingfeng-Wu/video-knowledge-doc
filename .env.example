# 本地开发可复制为.env；真实密钥不得提交到Git。
VIDEO_DOC_LLM_BACKEND=mock
VIDEO_DOC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VIDEO_DOC_LLM_API_KEY=
VIDEO_DOC_LLM_MODEL=qwen3.7-flash
VIDEO_DOC_LLM_TIMEOUT_SECONDS=60
VIDEO_DOC_LLM_ENABLE_THINKING=false
VIDEO_DOC_LLM_TEMPERATURE=0
VIDEO_DOC_LLM_MOCK_RESPONSE={"mock":true,"message":"local mock response"}

# M2使用config/model-roles.json；以上BACKEND=mock仅用于M1。
# run-m2真实调用仍需显式--allow-llm；不要把密钥填入registry。
